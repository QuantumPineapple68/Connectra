<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragments.ProfileFragment"
    android:background="@drawable/inverted_home_frag_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_marginBottom="85dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-65dp"
                android:src="@drawable/top_decor" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-180dp"
                android:layout_marginBottom="2dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/imageView_profile_dp"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_marginTop="40dp"
                        android:contentDescription="User Profile Picture"
                        android:scaleType="centerCrop"
                        android:src="@drawable/prof"
                        app:civ_border_color="#ffffff"
                        app:civ_border_width="5dp"/>

                    <ImageView
                        android:id="@+id/removeProfile"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="55dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/dele"
                        android:visibility="gone"/>


                </FrameLayout>

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Welcome Message -->
                <TextView
                    android:id="@+id/show_welcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/roboto_bold"
                    android:text="Loading .."
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.AppCompat.Headline"
                    android:textColor="@color/black" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/display_rating"
                        android:layout_width="140dp"
                        android:layout_height="32dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/r0"
                        android:contentDescription="Rating" />

                    <TextView
                        android:id="@+id/numb_revs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:text="(0)" />

                </LinearLayout>

                <TextView
                    android:id="@+id/show_bio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="-15dp"
                    android:layout_marginBottom="24dp"
                    android:hint="Write a bio ..."
                    android:maxHeight="200dp"
                    android:maxLines="3"
                    android:textAlignment="center"
                    android:textColor="#656565"
                    android:textSize="15dp" />

                <TextView
                    android:id="@+id/credits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="Made by Nachiket Jadhav (Click for Github)"
                    android:textAlignment="center"
                    android:textColor="#fc7b54"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Details Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Full Name -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/ic_profile"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/ic_profile"
                            android:contentDescription="Name Icon" />

                        <TextView
                            android:id="@+id/full_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="40dp"
                            android:hint="Loading..."
                            android:textColor="@android:color/black"
                            android:textSize="16sp" />
                    </RelativeLayout>

                    <!-- Email -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/ic_email"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/ic_email"
                            android:contentDescription="Email Icon" />

                        <TextView
                            android:id="@+id/show_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="40dp"
                            android:hint="Loading..."
                            android:textColor="@android:color/black"
                            android:textSize="16sp" />
                    </RelativeLayout>

                    <!-- Gender -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/ic_gender"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/ic_gender"
                            android:contentDescription="Gender Icon" />

                        <TextView
                            android:id="@+id/show_gender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="40dp"
                            android:hint="Loading..."
                            android:textColor="@android:color/black"
                            android:textSize="16sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/hat"
                            android:contentDescription="Skill Icon" />

                        <TextView
                            android:id="@+id/myskill_change"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="40dp"
                            android:hint="Loading..."
                            android:textColor="@android:color/black"
                            android:textSize="16sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/humanskill"
                            android:contentDescription="Goal Icon" />

                        <TextView
                            android:id="@+id/goalskill_change"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="40dp"
                            android:hint="Loading..."
                            android:textColor="@android:color/black"
                            android:textSize="16sp" />
                    </RelativeLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/skillChange"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="@color/theme_dark"
                    android:fontFamily="@font/inter_bold"
                    android:text="Edit Profile"
                    android:textColor="@android:color/white" />

                <!-- Skill DNA: live preview of the shareable card, tap to share -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/share_dna_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/dna_preview_image"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:contentDescription="Skill DNA card preview"
                            android:scaleType="fitXY"
                            app:layout_constraintDimensionRatio="H,4:5"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/dna_preview_shimmer"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="@id/dna_preview_image"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/dna_preview_image"
                            app:shimmer_auto_start="true">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/shimmer_rect" />

                        </com.facebook.shimmer.ShimmerFrameLayout>

                        <TextView
                            android:id="@+id/dna_share_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:background="#CC170B2E"
                            android:fontFamily="@font/inter_bold"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="Generating your Skill DNA ..."
                            android:textColor="@android:color/white"
                            android:textSize="15sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <Button
                    android:id="@+id/report"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="#E53935"
                    android:fontFamily="@font/inter_bold"
                    android:text="Report Content"
                    android:textColor="@android:color/white"
                    android:drawablePadding="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <Button
                    android:id="@+id/logout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="@color/theme_dark"
                    android:fontFamily="@font/inter_bold"
                    android:text="Log Out"
                    android:textColor="@android:color/white" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>